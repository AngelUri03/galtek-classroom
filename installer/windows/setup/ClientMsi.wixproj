<Project Sdk="WixToolset.Sdk/5.0.2">
  <Import Project="InstallerVersion.props" />

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Platform>x64</Platform>
    <Cultures>en-US</Cultures>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      ProductCode=$(ProductCode);
      ProductUpgradeCode=$(ProductUpgradeCode);
      PayloadRoot=$(PayloadRoot);
      BrandingRoot=$(BrandingRoot);
      CredentialPackageId=$(CredentialPackageId);
      GitCommit=$(GitCommit);
      BuildTimestampUtc=$(BuildTimestampUtc);
      ClientStateHelperPath=$(ClientStateHelperPath)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <Compile Include="Package.wxs" />
    <Compile Include="$(GeneratedPayloadWxs)" Condition="'$(GeneratedPayloadWxs)' != ''" />
  </ItemGroup>
</Project>
